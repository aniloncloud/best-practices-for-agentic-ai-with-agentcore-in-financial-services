# assets/ IS the participant workspace seed and IS tracked (source of truth).
# Deploy it to the Workshop Studio asset bucket with:
#   aws s3 sync ./assets s3://ws-assets-us-east-1/<content-id> --delete
# The agentcore/ scaffold is generated by the devbox at boot — never commit it.
assets/agentcore/

# OS
.DS_Store

# Claude Code / OMC
.omc/
.gstack/
conductor/

# Python build/runtime artifacts
**/__pycache__/
*.pyc
**/venv/
**/.venv/

# Node / CDK build artifacts
**/node_modules/
**/cdk.out/

# Secrets — never commit
**/.env.local

# Internal working doc — not shipped with workshop content
HARNESS_COMMANDS.md
