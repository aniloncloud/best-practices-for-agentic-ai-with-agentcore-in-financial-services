{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllReaperSupportedServices",
            "Effect": "Allow",
            "Action": [
                "cloudformation:*",
                "cloudtrail:*",
                "cloudwatch:*",
                "events:*",
                "logs:*",
                "sts:*",
                "tag:*",
                "xray:*",
                "cognito-idp:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "S3FullAccess",
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "LambdaFullAccess",
            "Effect": "Allow",
            "Action": [
                "lambda:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "ECRFullAccess",
            "Effect": "Allow",
            "Action": [
                "ecr:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "CodeBuildFullAccess",
            "Effect": "Allow",
            "Action": [
                "codebuild:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "SSMFullAccess",
            "Effect": "Allow",
            "Action": [
                "ssm:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "KMSForCDKBootstrap",
            "Effect": "Allow",
            "Action": [
                "kms:CreateKey",
                "kms:CreateAlias",
                "kms:DeleteAlias",
                "kms:DescribeKey",
                "kms:Encrypt",
                "kms:Decrypt",
                "kms:GenerateDataKey",
                "kms:GetKeyPolicy",
                "kms:GetKeyRotationStatus",
                "kms:ListAliases",
                "kms:ListKeys",
                "kms:PutKeyPolicy",
                "kms:ScheduleKeyDeletion",
                "kms:TagResource",
                "kms:UntagResource",
                "kms:ListResourceTags",
                "kms:EnableKeyRotation"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "SecretsManagerFullAccess",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "IAMPermissions",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:CreatePolicy",
                "iam:AttachRolePolicy",
                "iam:PutRolePolicy",
                "iam:GetRole",
                "iam:GetPolicy",
                "iam:GetRolePolicy",
                "iam:ListRolePolicies",
                "iam:ListAttachedRolePolicies",
                "iam:DeleteRole",
                "iam:DeletePolicy",
                "iam:DetachRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:UpdateAssumeRolePolicy"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "IAMPassRole",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole"
            ],
            "Resource": [
                "*"
            ],
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": [
                        "bedrock.amazonaws.com",
                        "bedrock-agentcore.amazonaws.com",
                        "lambda.amazonaws.com",
                        "codebuild.amazonaws.com"
                    ]
                }
            }
        },
        {
            "Sid": "IAMCreateServiceLinkedRole",
            "Effect": "Allow",
            "Action": [
                "iam:CreateServiceLinkedRole"
            ],
            "Resource": [
                "arn:aws:iam::*:role/aws-service-role/bedrock-agentcore.amazonaws.com/*",
                "arn:aws:iam::*:role/aws-service-role/bedrock.amazonaws.com/*",
                "arn:aws:iam::*:role/aws-service-role/lambda.amazonaws.com/*",
                "arn:aws:iam::*:role/aws-service-role/codebuild.amazonaws.com/*"
            ]
        },
        {
            "Sid": "BedrockAgentCoreFullAccess",
            "Effect": "Allow",
            "Action": [
                "bedrock-agentcore:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "BedrockAgentCoreObservability",
            "Effect": "Allow",
            "Action": [
                "application-signals:StartDiscovery"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "AmazonBedrockReadOnly",
            "Effect": "Allow",
            "Action": [
                "bedrock:Get*",
                "bedrock:List*",
                "bedrock:PutUseCaseForModelAccess",
                "aws-marketplace:Unsubscribe",
                "aws-marketplace:ViewSubscriptions",
                "bedrock:PutModelInvocationLoggingConfiguration"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "BedrockPolicies",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream",
                "bedrock:TagResource",
                "bedrock:UntagResource"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "BedrockModelSubscriptions",
            "Effect": "Allow",
            "Action": [
                "aws-marketplace:Subscribe",
                "aws-marketplace:Unsubscribe"
            ],
            "Resource": [
                "*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws-marketplace:ProductId": [
                        "prod-mxcfnwvpd6kb4",
                        "prod-xdkflymybwmvi",
                        "prod-ffvjxvh4ltq64",
                        "b7568428-a1ab-46d8-bab3-37def50f6f6a",
                        "38e55671-c3fe-4a44-9783-3584906e7cad",
                        "prod-ft3cj5gst3spo"
                    ]
                }
            }
        },
        {
            "Sid": "BedrockModelAccess",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream",
                "bedrock:ListFoundationModelAgreementOffers",
                "bedrock:PutFoundationModelEntitlement",
                "bedrock:CreateFoundationModelAgreement"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "EC2BasicAccess",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*",
                "ec2:RunInstances",
                "ec2:TerminateInstances",
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:CreateTags",
                "ec2:CreateSecurityGroup",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:DeleteSecurityGroup",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupEgress",
                "ec2:CreateVpc",
                "ec2:DeleteVpc",
                "ec2:ModifyVpcAttribute",
                "ec2:CreateSubnet",
                "ec2:DeleteSubnet",
                "ec2:CreateRouteTable",
                "ec2:DeleteRouteTable",
                "ec2:CreateRoute",
                "ec2:DeleteRoute",
                "ec2:AssociateRouteTable",
                "ec2:DisassociateRouteTable",
                "ec2:CreateInternetGateway",
                "ec2:DeleteInternetGateway",
                "ec2:AttachInternetGateway",
                "ec2:DetachInternetGateway",
                "ec2:CreateNatGateway",
                "ec2:DeleteNatGateway",
                "ec2:AllocateAddress",
                "ec2:ReleaseAddress",
                "ec2:CreateVpcEndpoint",
                "ec2:DeleteVpcEndpoints",
                "ec2:ModifyVpcEndpoint"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "DenyXXLInstances",
            "Effect": "Deny",
            "Action": [
                "ec2:RunInstances"
            ],
            "Resource": [
                "arn:aws:ec2:*:*:instance/*"
            ],
            "Condition": {
                "StringLike": {
                    "ec2:InstanceType": [
                        "*6xlarge",
                        "*8xlarge",
                        "*10xlarge",
                        "*12xlarge",
                        "*16xlarge",
                        "*18xlarge",
                        "*24xlarge",
                        "f1.4xlarge",
                        "x1*",
                        "z1*",
                        "*metal"
                    ]
                }
            }
        },
        {
            "Sid": "DontBuyEC2ReservationsPlz",
            "Effect": "Deny",
            "Action": [
                "ec2:ModifyReservedInstances",
                "ec2:PurchaseHostReservation",
                "ec2:PurchaseReservedInstancesOffering",
                "ec2:PurchaseScheduledInstances"
            ],
            "Resource": [
                "arn:aws:ec2:*:*:*"
            ]
        },
        {
            "Sid": "DontBuyRDSReservationsPlz",
            "Effect": "Deny",
            "Action": [
                "rds:PurchaseReservedDBInstancesOffering"
            ],
            "Resource": [
                "arn:aws:rds:*:*:*"
            ]
        },
        {
            "Sid": "DontBuyDynamodbReservationsPlz",
            "Effect": "Deny",
            "Action": [
                "dynamodb:PurchaseReservedCapacityOfferings"
            ],
            "Resource": [
                "arn:aws:dynamodb:*:*:*"
            ]
        }
    ]
}
